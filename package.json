{
  "name": "lorin-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:css": "stylelint '**/*.css' --ignore-path .gitignore",
    "lint:css:fix": "stylelint '**/*.css' --fix --ignore-path .gitignore",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "verify": "start-server-and-test 'next dev' http://localhost:3000 'npm run lint && npm run lint:css && npm test'",
    "verify:perf": "next build && start-server-and-test 'next start -p 3001' http://localhost:3001 'node scripts/lighthouse.mjs'"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "next": "^14.0.0",
    "next-cloudinary": "^6.17.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "lighthouse": "^13.1.0",
    "start-server-and-test": "^3.0.2",
    "stylelint": "^17.3.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
